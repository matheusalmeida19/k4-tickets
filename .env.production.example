# Modelo sem credenciais. Configure cada ambiente no painel privado da Vercel.
APP_BASE_URL=https://SEU-PROJETO.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TRACKING_SECRET=
RATE_LIMIT_SECRET=
PAYMENT_PROVIDER=unconfigured
CHARGE_TTL_SECONDS=900
# Opcional: exibir um único evento publicado na página inicial.
FEATURED_EVENT_SLUG=
